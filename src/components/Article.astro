---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { articleSlug, type ArticleEntry } from '../data/articles';
import { articlePath, pagePath, site } from '../data/site';

interface Props { entry: ArticleEntry; counterpart: ArticleEntry }
const { entry, counterpart } = Astro.props;
const { locale } = entry.data;
const copy = site.copy[locale];
const otherLocale = locale === 'pl' ? 'en' : 'pl';
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.title} — ${site.name}`}
  description={entry.data.description}
  locale={locale}
  page="materials"
  path={articlePath(locale, articleSlug(entry))}
  alternatePath={articlePath(otherLocale, articleSlug(counterpart))}
>
  <article class="article">
    <header class="article-header">
      <div class="article-meta">
        <a class="article-back mono" href={pagePath(locale, 'materials')}>← {copy.backToMaterials}</a>
        <span class="article-topic label">{entry.data.topic}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="article-lead">{entry.data.summary}</p>
    </header>
    <div class="article-content"><Content /></div>
    <footer class="article-footer">
      <a class="mono" href={pagePath(locale, 'materials')}>← {copy.backToMaterials}</a>
    </footer>
  </article>
</Base>

<style>
  .article { width: 100%; max-width: 680px; margin-inline: auto; padding-top: clamp(32px, 4vw, 48px); }
  .article-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .article-back { font-size: .78rem; }
  .article-topic { flex: none; }
  h1 { margin-top: 16px; font-size: clamp(1.7rem, 2.5vw, 2.15rem); line-height: 1.18; }
  .article-lead { margin: 8px 0 18px; color: var(--fg-muted); font-size: 1rem; line-height: 1.5; }
  .article-content { border-top: 1px solid var(--line); padding-top: 14px; font-size: 1rem; line-height: 1.62; }
  .article-content :global(h2) { margin: 30px 0 10px; color: var(--accent); font-size: clamp(1.25rem, 1.8vw, 1.5rem); line-height: 1.3; }
  .article-content :global(h2:first-child) { margin-top: 6px; }
  .article-content :global(h3) { margin: 22px 0 8px; font-size: 1.08rem; line-height: 1.3; }
  .article-content :global(p) { margin: 0 0 12px; }
  .article-content :global(ul), .article-content :global(ol) { padding-left: 1.35em; margin: 0 0 16px; }
  .article-content :global(li) { padding-left: .15em; margin: 0 0 6px; }
  .article-content :global(li::marker) { color: var(--accent); }
  .article-content :global(blockquote) { margin: 18px 0; padding: 2px 0 2px 16px; border-left: 2px solid var(--accent); color: var(--fg-muted); }
  .article-content :global(blockquote p:last-child) { margin-bottom: 0; }
  .article-content :global(strong) { font-weight: 600; color: var(--fg); }
  .article-content :global(hr) { margin: 32px 0; border: 0; border-top: 1px solid var(--line); }
  .article-content :global(img) { display: block; max-width: 100%; height: auto; }
  .article-content :global(.article-media-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; max-width: 560px; margin: 18px auto 24px; }
  .article-content :global(.article-media-grid figure) { min-width: 0; margin: 0; border: 1px solid var(--line); background: var(--bg-card); }
  .article-content :global(.article-media-grid img) { width: 100%; height: 150px; object-fit: contain; }
  .article-content :global(.article-media-grid figcaption) { padding: 6px 8px; border-top: 1px solid var(--line); font-family: var(--font-mono); font-size: .7rem; color: var(--fg-muted); }
  .article-content :global(.article-media-pair img) { height: auto; aspect-ratio: 1; }
  .article-content :global(.article-figure) { width: fit-content; max-width: min(100%, 280px); margin: 18px auto 24px; }
  .article-content :global(.article-figure-wide) { max-width: min(100%, 420px); }
  .article-content :global(.article-figure img) { border: 1px solid var(--line); }
  .article-content :global(.article-note) { margin: 16px 0; padding: 12px 14px; border-left: 2px solid #72a6c4; border-radius: 3px; background: #1c2a33; }
  .article-content :global(.article-note p:last-child) { margin-bottom: 0; }
  .article-content :global(.example) { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 8px; margin: 14px 0; padding: 12px 14px; border: 1px solid; border-radius: 3px; }
  .article-content :global(.example-good) { background: #1a2921; border-color: #355443; }
  .article-content :global(.example-bad) { background: #2c1c1a; border-color: #553a35; }
  .article-content :global(.example-mark) { font-family: var(--font-mono); font-size: 1rem; font-weight: 700; }
  .article-content :global(.example-good .example-mark) { color: #81bf92; }
  .article-content :global(.example-bad .example-mark) { color: #df877c; }
  .article-content :global(.example p) { margin: 0; }
  .article-content :global(.example p + p) { margin-top: 8px; }
  .article-footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); font-size: .8rem; }
  @media (max-width: 720px) {
    .article { padding-top: 32px; }
    .article-content :global(.article-media-grid) { gap: 8px; }
    .article-content :global(.article-media-grid img) { height: 120px; }
  }
  @media (max-width: 540px) {
    .article-content :global(.article-media-pair) { grid-template-columns: 1fr; }
    .article-content :global(.article-media-pair figure) { width: min(100%, 260px); margin-inline: auto; }
  }
  @media (max-width: 420px) {
    .article-content :global(.article-media-grid) { grid-template-columns: 1fr; max-width: 230px; }
    .article-content :global(.article-media-grid img) { height: auto; max-height: 230px; }
    .article-content :global(.article-figure) { max-width: min(100%, 230px); }
    .article-content :global(.article-figure-wide) { max-width: 100%; }
  }
</style>
