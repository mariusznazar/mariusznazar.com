---
import type { ArticleEntry } from '../data/articles';
import { articleSlug } from '../data/articles';
import { articlePath, type Locale } from '../data/site';

interface Props { locale: Locale; entries: ArticleEntry[]; headingLevel?: 2 | 3 }
const { locale, entries, headingLevel = 2 } = Astro.props;
---

<div class="article-list">
  {entries.map((entry) => (
    <article class="article-item">
      <a class="article-link" href={articlePath(locale, articleSlug(entry))}>
        <span class="article-topic label">{entry.data.topic}</span>
        <div class="article-main">
          <div class="article-title-row">
            {headingLevel === 2 ? <h2>{entry.data.title}</h2> : <h3>{entry.data.title}</h3>}
            <span class="article-arrow mono" aria-hidden="true">↗</span>
          </div>
          <span class="article-summary">{entry.data.summary}</span>
        </div>
      </a>
    </article>
  ))}
</div>

<style>
  .article-list { border-top: 1px solid var(--line); }
  .article-item { border-bottom: 1px solid var(--line); }
  .article-link { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 18px; padding: 16px 0; border: 0; color: var(--fg); }
  .article-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .article-topic { padding-top: 4px; }
  .article-title-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  h2, h3 { font-size: clamp(1.12rem, 1.9vw, 1.35rem); line-height: 1.3; }
  .article-arrow { flex: none; color: var(--accent); font-size: .9rem; }
  .article-summary { display: block; max-width: 70ch; margin-top: 4px; color: var(--fg-muted); font-size: .92rem; line-height: 1.45; }
  .article-link:hover :is(h2, h3) { color: var(--accent); }
  @media (max-width: 600px) {
    .article-link { grid-template-columns: 1fr; gap: 5px; padding: 14px 0 16px; }
    .article-topic { padding-top: 0; }
  }
</style>
