---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArticleList from './ArticleList.astro';
import LinkIcon, { type IconName } from './LinkIcon.astro';
import portrait from '../assets/mariusz-nazar-2026.png';
import { articlesFor } from '../data/articles';
import { pagePath, site, type Locale } from '../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = site.copy[locale];
const articles = (await articlesFor(locale)).slice(0, 2);
const links: Array<{ label: string; href: string; icon?: IconName; title?: string }> = [
  { label: 'Bio', href: pagePath(locale, 'bio') },
  { label: copy.materials, href: pagePath(locale, 'materials') },
  { label: 'GitHub', href: 'https://github.com/mariusznazar', icon: 'github' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mariusz-nazar-100/', icon: 'linkedin' },
  { label: 'Printables', href: 'https://www.printables.com/@MariuszNazar_5604422', icon: 'printables' },
  { label: 'Loop2', href: 'https://loop2.mariusznazar.com/', icon: 'loop2', title: copy.loop2Title },
  { label: copy.email, href: 'mailto:mariusznn@gmail.com', icon: 'mail' },
];
---

<Base title={site.name} description={copy.description} locale={locale} page="home">
  <section class="hero">
    <div class="hero-heading">
      <h1 class="hero-name">{site.name}</h1>
      <p class="hero-tagline mono">{copy.tagline}</p>
    </div>
    <Image
      class="hero-portrait"
      src={portrait}
      alt={copy.portraitAlt}
      width={600}
      format="webp"
      loading="eager"
    />
    <div class="hero-body">
      {copy.intro.map((paragraph) => <p class="hero-intro">{paragraph}</p>)}
      <p class="hero-links mono">
        {links.map((link) => (
          <a class="hero-link" href={link.href} title={link.title}>
            {link.icon && <LinkIcon name={link.icon} />}{link.label}
          </a>
        ))}
      </p>
    </div>
  </section>
  {articles.length > 0 && (
    <section class="home-materials" aria-labelledby="home-materials-heading">
      <div class="home-materials-heading">
        <h2 id="home-materials-heading">{copy.materials}</h2>
        <a class="mono" href={pagePath(locale, 'materials')}>{copy.viewAllMaterials} ↗</a>
      </div>
      <ArticleList locale={locale} entries={articles} headingLevel={3} />
    </section>
  )}
</Base>

<style>
  .hero {
    display: grid;
    max-width: 1080px;
    margin-inline: auto;
    grid-template-columns: 300px minmax(0, 1fr);
    grid-template-areas: 'portrait heading' 'portrait body';
    column-gap: clamp(32px, 5vw, 72px);
    row-gap: 18px;
    padding: clamp(40px, 6vw, 72px) 0 12px;
    align-items: center;
  }
  .hero-heading { grid-area: heading; align-self: end; }
  .hero-name { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin-bottom: 18px; }
  .hero-tagline { color: var(--accent); font-size: 0.9rem; line-height: 1.6; margin: 0; }
  .hero-portrait { grid-area: portrait; display: block; width: 100%; max-width: 300px; height: auto; border: 1px solid var(--line); }
  /* The width is set on the whole body, in the intro's font size, so the links wrap at the paragraph's edge. */
  .hero-body { grid-area: body; align-self: start; max-width: 50ch; font-size: 1.05rem; }
  .hero-intro { font-size: inherit; margin: 0 0 14px; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 0.85rem; margin: 24px 0 0; }
  .hero-link { display: inline-flex; align-items: center; gap: 7px; }
  .home-materials { max-width: 860px; margin: clamp(24px, 4vw, 56px) auto 0; }
  .home-materials-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; margin-bottom: 16px; }
  .home-materials-heading h2 { font-size: clamp(1.5rem, 2.5vw, 1.9rem); }
  .home-materials-heading a { font-size: .78rem; }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'heading' 'portrait' 'body';
      row-gap: 28px;
      padding-top: 48px;
    }
    .hero-name { margin-bottom: 12px; }
    .hero-portrait { justify-self: center; }
    .home-materials-heading { align-items: start; flex-direction: column; gap: 12px; }
  }
</style>
