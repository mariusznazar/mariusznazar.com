---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { pagePath, site, type Locale, type Page } from '../data/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  page: Page;
  path?: string;
  alternatePath?: string;
}
const { title, description, locale, page, path, alternatePath } = Astro.props;
const copy = site.copy[locale];
const currentPath = path ?? pagePath(locale, page);
const otherLocale: Locale = locale === 'pl' ? 'en' : 'pl';
const otherPath = alternatePath ?? pagePath(otherLocale, page);
const localizedPaths = locale === 'pl'
  ? { pl: currentPath, en: otherPath }
  : { pl: otherPath, en: currentPath };
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(currentPath, Astro.site)} />
    <link rel="alternate" hreflang="pl" href={new URL(localizedPaths.pl, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(localizedPaths.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPaths.pl, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <header class="topbar container" transition:animate="none">
      <a class="topbar-name" href={pagePath(locale, 'home')} transition:persist="site-name">{site.name}</a>
      <div class="topbar-actions">
        <a class="topbar-materials mono" href={pagePath(locale, 'materials')} aria-current={currentPath === pagePath(locale, 'materials') ? 'page' : undefined}>{copy.materials}</a>
        <nav class="language-switch mono" aria-label={locale === 'pl' ? 'Język strony' : 'Page language'}>
          <span aria-current="page">{locale.toUpperCase()}</span>
          <span aria-hidden="true">/</span>
          <a href={otherPath} hreflang={otherLocale} lang={otherLocale} data-astro-reload>{otherLocale.toUpperCase()}</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="footer container">
      <a href={site.repo}>{copy.sourceCode}</a>
    </footer>
  </body>
</html>

<style>
  .topbar {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding-top: 20px; padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .topbar-name { font-family: var(--font-display); font-weight: 500; color: var(--fg); border: 0; }
  .topbar-actions { display: flex; align-items: baseline; gap: clamp(16px, 3vw, 32px); }
  .topbar-materials { font-size: 0.75rem; color: var(--fg-muted); }
  .topbar-materials[aria-current] { color: var(--accent); }
  .language-switch {
    display: flex; gap: 6px; align-items: baseline;
    font-size: 0.75rem; color: var(--fg-dim);
  }
  .language-switch [aria-current] { color: var(--fg); }
  @media (max-width: 480px) { .topbar-actions { gap: 12px; } }
  .footer {
    margin-top: 64px; padding-top: 16px; padding-bottom: 32px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-dim);
  }
</style>
