---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { site } from '../data/site';
---

<Base title={site.name} description={site.description}>
  <section class="hero">
    <h1 class="hero-name">{site.name}</h1>
    <p class="hero-tagline mono">{site.tagline}</p>
    {site.intro.map((paragraph) => <p class="hero-intro">{paragraph}</p>)}
    <p class="hero-links mono">
      {site.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </p>
  </section>

  <Timeline />
</Base>

<style>
  .hero { padding: 56px 0 40px; }
  .hero-name { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 6px; }
  .hero-tagline { color: var(--accent); font-size: 0.9rem; margin: 0 0 24px; }
  .hero-intro { max-width: var(--measure); font-size: 1.05rem; margin: 0 0 14px; }
  .hero-links { display: flex; gap: 20px; font-size: 0.85rem; margin: 20px 0 0; }
</style>
